# toa-mcp — no secrets in this file. Copy to .env and fill in.

# Path to the toa-rules checkout (the data layer). Required.
TOA_RULES_PATH=/srv/toa-rules

# Read-only mount of the apps checkout. Optional — enables get_app_profile, which
# reads each app's live accent from tokens.css instead of trusting AGENTS.md.
# Not a submodule on purpose: a pinned commit would freeze the profile.
# Leave unset locally if the mount is absent; the tool then fails with an explanation.
TOA_APPS_PATH=/srv/apps

# Bearer token the ASGI middleware validates. Required.
# Generate with: openssl rand -base64 32
TOA_MCP_TOKEN=

TOA_MCP_HOST=0.0.0.0
TOA_MCP_PORT=8000
TOA_MCP_LOG_LEVEL=INFO

# --- compose only: host-side paths for the two read-only mounts ---
# No defaults on purpose — a hardcoded /home/<user>/... path is catch-up item 14.
TOA_RULES_HOST_PATH=
TOA_APPS_HOST_PATH=
